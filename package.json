{
  "name": "bretos-web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "node scripts/validate.mjs",
    "test": "node tests/validate.test.mjs && node tests/contenidos.test.mjs && node tests/lineas.test.mjs",
    "test:g1": "node tests/validate.test.mjs",
    "test:g3": "node tests/contenidos.test.mjs",
    "test:lineas": "node tests/lineas.test.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "verify": "npm run validate && npm test && npm run build && npm run check:routes"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
