---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = 'Bretos Services — proyecto chileno en etapa piloto. Líneas de conexión digital presentadas con su estado real.',
  currentPath = '/'
} = Astro.props;

const primaryNav = [
  { href: '/', label: 'Inicio' },
  { href: '/catalogo', label: 'Catálogo' },
  { href: '/bai', label: 'BAI' },
  { href: '/como-trabajamos', label: 'Cómo trabajamos' },
  { href: '/nosotros', label: 'Proyecto' },
  { href: '/contacto', label: 'Contacto' }
];

const secondaryNav = [
  { href: '/ruta', label: 'Ruta y avances' },
  { href: '/contenidos', label: 'Centro de contenidos' }
];

const legalNav = [
  { href: '/privacidad', label: 'Privacidad' },
  { href: '/cookies', label: 'Cookies' },
  { href: '/terminos', label: 'Términos' }
];

const siteName = 'Bretos Services';
const isCurrent = (href: string) => href === currentPath;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Vista previa pública: no se indexa hasta que exista contenido aprobado. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a7f80" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
  </head>
  <body data-page={currentPath}>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand" aria-label={`${siteName} — ir al inicio`}>
          <img src="/images/bretos-services-logo.png" alt="Bretos Services" width="445" height="197" />
        </a>

        <nav class="nav-desktop" aria-label="Navegación principal">
          {primaryNav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>

        <details class="nav-mobile" id="nav-mobile">
          <summary>Menú</summary>
          <nav class="nav-mobile-panel" aria-label="Navegación principal en móvil">
            {primaryNav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
            {secondaryNav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
        </details>
      </div>
    </header>

    <main id="contenido-principal">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <img src="/images/bretos-services-footer-logo.png" alt="Bretos Services" width="445" height="197" loading="lazy" />
            <p>
              Proyecto chileno en etapa piloto. No existe entidad legal constituida y no hay oferta
              comercial cerrada: cada línea se presenta con el estado que realmente tiene.
            </p>
            <p class="footer-note">
              Vista previa pública. No es el sitio comercial definitivo y no se indexa en buscadores.
            </p>
          </div>

          <nav class="footer-col" aria-labelledby="footer-sitio">
            <h2 id="footer-sitio">Sitio</h2>
            <a href="/catalogo">Catálogo</a>
            <a href="/como-trabajamos">Cómo trabajamos</a>
            {secondaryNav.map((item) => <a href={item.href}>{item.label}</a>)}
            <a href="/bai">BAI (inactivo)</a>
          </nav>

          <nav class="footer-col" aria-labelledby="footer-proyecto">
            <h2 id="footer-proyecto">Proyecto</h2>
            <a href="/nosotros">Sobre el proyecto</a>
            <a href="/contacto">Contacto</a>
            {legalNav.map((item) => <a href={item.href}>{item.label}</a>)}
            <span class="footer-note">WhatsApp oficial: +56 9 3651 2828</span>
          </nav>
        </div>

        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Bretos Services · Proyecto en validación</span>
          <span class="footer-stage">Etapa piloto · sin stock confirmado · sin venta en línea</span>
        </div>
      </div>
    </footer>

    <script is:inline src="/scripts/mobile-nav.js"></script>
  </body>
</html>
