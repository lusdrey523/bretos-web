---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = 'Bretos Services — soluciones de conexión digital para negocios en Chile. Etapa piloto.',
  currentPath = '/'
} = Astro.props;

const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/catalogo', label: 'Catálogo' },
  { href: '/nosotros', label: 'Proyecto' },
  { href: '/ruta', label: 'Ruta y avances' },
  { href: '/contenidos', label: 'Aprendizaje' },
  { href: '/contacto', label: 'Contacto' }
];

const siteName = "Bretos Services";
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#18C7C8" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="sr-only" href="#contenido-principal">Saltar al contenido</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo-link" aria-label={`${siteName} — inicio`}>
          <img class="brand-logo" src="/images/bretos-logo-prototype.png" alt="" width="1834" height="830" />
          <span class="sr-only">{siteName}</span>
        </a>

        <nav class="nav-desktop" aria-label="Principal">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <button
          type="button"
          class="menu-toggle"
          id="menu-toggle"
          aria-expanded="false"
          aria-controls="nav-mobile"
          aria-label="Abrir menú"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <nav class="nav-mobile" id="nav-mobile" aria-label="Móvil">
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main id="contenido-principal">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>
          Bretos Services · Proyecto piloto · Estado presentado con transparencia
        </p>
        <p>
          Vista previa pública · No es una oferta comercial cerrada
        </p>
      </div>
    </footer>

    <script is:inline src="/scripts/mobile-nav.js"></script>
  </body>
</html>

