---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada — Bretos Services"
  description="La dirección solicitada no existe en este sitio."
  currentPath="/404"
>
  <section class="notfound">
    <div class="wrap wrap--narrow">
      <span class="kicker">Error 404</span>
      <h1>404</h1>
      <h2>Esta dirección no existe</h2>
      <p class="lead">
        Puede que el enlace esté mal escrito o que la página todavía no se haya publicado. El sitio
        está en construcción, así que parte de su contenido previsto aún no está disponible.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href="/">Ir al inicio</a>
        <a class="btn btn--ghost" href="/catalogo">Ver el catálogo</a>
      </div>
    </div>
  </section>
</Layout>
