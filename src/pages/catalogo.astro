---
import Layout from '../layouts/Layout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import catalogo from '../../data/catalogo.json';

const items = catalogo.items ?? [];
const enPiloto = items.filter((item) => item.status === 'pilot').length;
const previstas = items.filter((item) => item.provenance === 'propuesto').length;
---

<Layout
  title="Catálogo — Bretos Services"
  description="Las cuatro líneas previstas de Bretos Services, con su estado real: dos en etapa piloto y dos previstas con alcance por confirmar."
  currentPath="/catalogo"
>
  <section class="page-head">
    <div class="wrap">
      <span class="kicker">Catálogo</span>
      <h1>Catálogo de servicios</h1>
      <p class="lead">
        Cuatro líneas, ninguna igual de avanzada. Dos están en etapa piloto y dos son intención de
        negocio con alcance por confirmar. El estado de cada una está escrito en su ficha.
      </p>
      <div class="notice" style="margin-top:1.4rem">
        <strong>Sin stock confirmado y sin venta en línea.</strong>
        Ningún precio comercial está confirmado y este sitio no procesa pagos. «En etapa piloto» o
        «línea prevista» no equivalen a disponibilidad comercial.
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      {items.length === 0 ? (
        <div class="notice">
          <strong>Sin líneas cargadas.</strong> Se publicarán cuando exista información validada y aprobada.
        </div>
      ) : (
        <div class="catalog-list">
          {items.map((item, index) => (
            <article class="catalog-entry" id={item.id}>
              <span class="catalog-entry-idx" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>

              <div class="catalog-entry-main">
                <h2><a href={`/catalogo/${item.id}`}>{item.name}</a></h2>
                <p>{item.description}</p>
                <div class="catalog-entry-meta">
                  <StatusBadge status={item.status} />
                  {item.provenance === 'propuesto' ? (
                    <span class="line-row-desc">Alcance por confirmar</span>
                  ) : (
                    <span class="line-row-desc">Descripción verificada</span>
                  )}
                </div>
              </div>

              <dl class="catalog-entry-facts">
                <dt>Disponibilidad</dt>
                <dd>{item.availability}</dd>
                <dt>Precio</dt>
                <dd>{item.pricing}</dd>
              </dl>
            </article>
          ))}
        </div>
      )}

      <p class="note" style="margin-top:1.4rem">
        {enPiloto} línea(s) en etapa piloto y {previstas} línea(s) previstas. Los datos de stock
        disponibles son registros históricos: no se afirma que la situación haya cambiado y la
        disponibilidad actual está por confirmar.
      </p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="kicker">Antes de cotizar</span>
          <h2>Qué se necesita para hablar de una línea concreta</h2>
        </div>
      </div>
      <ul class="rules-list">
        <li>Saber qué destino quiere abrir el negocio y quién lo administra.</li>
        <li>Confirmar si la pieza es para un local, varios, o para un equipo.</li>
        <li>Aceptar que reseñas y resultados dependen de terceros y de las personas, no del producto.</li>
        <li>Dejar por escrito el alcance antes de producir o construir cualquier cosa.</li>
      </ul>
      <div class="actions">
        <a class="btn btn--primary" href="/contacto">Consultar por WhatsApp</a>
        <a class="btn btn--ghost" href="/como-trabajamos">Ver cómo se trabaja</a>
      </div>
    </div>
  </section>
</Layout>
