---
import StatusBadge from './StatusBadge.astro';

interface Props {
  id: string;
  name: string;
  status: string;
  description?: string;
}

const { id, name, status, description } = Astro.props;
---

<li>
  <h3 style="margin-bottom:.4rem">
    <a href={`/catalogo/${id}`} style="color:inherit;text-decoration:none">{name}</a>
  </h3>
  {description && <p class="note">{description}</p>}
  <StatusBadge status={status} />
</li>
